{
  "info": {
    "name": "Ripples API",
    "description": "Converted from REST Client (.http) collection. Uses collection variables to chain requests (tokens, IDs) similar to the original @name captures.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "healthUrl", "value": "http://localhost:3000/health", "type": "string" },
    { "key": "authToken", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "refreshToken", "value": "YOUR_REFRESH_TOKEN_HERE", "type": "string" },
    { "key": "postId", "value": "POST_ID_HERE", "type": "string" },
    { "key": "commentId", "value": "COMMENT_ID_HERE", "type": "string" },
    { "key": "communityId", "value": "COMMUNITY_ID_HERE", "type": "string" },
    { "key": "userId", "value": "USER_ID_HERE", "type": "string" },
    { "key": "newUserToken", "value": "", "type": "string" },
    { "key": "testCommunityId", "value": "", "type": "string" },
    { "key": "testPostId", "value": "", "type": "string" },
    { "key": "testCommentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{healthUrl}}"
      }
    },
    {
